[gd_scene format=3 uid="uid://cx31mx36sx8kb"]

[sub_resource type="GDScript" id="GDScript_4stdu"]
script/source = "extends Control

@onready var winner_label: Label = $VBoxContainer/WinnerLabel
var winner_id: int = 0

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	winner_label.text = \"Player %d won!\" % (winner_id+1)

func _process(_delta: float) -> void:
	if Input.is_action_just_pressed(\"p_reset@all\"):
		Director.change_to_test_level()
"

